PORT=3000
APP_ORIGIN=http://localhost:3000
DATABASE_PATH=data/astralab.sqlite
# Set only when requests arrive through a trusted reverse proxy.
TRUST_PROXY=
# Run npm run admin with ADMIN_USERNAME, ADMIN_EMAIL, ADMIN_PASSWORD set server-side.
# Provider settings stay on the server. Checkout remains unavailable until configured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional OAuth credentials; never place them in VITE_ variables.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
